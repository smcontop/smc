{
  "marketplaceId": "EBAY_US",

  "search": {
    "types": ["cpu", "gpu", "ram"],
    "priceMin": 40,
    "priceMax": 3000,
    "itemLocationCountry": "US",
    "includeAuctions": false,
    "maxItemsPerQuery": 200,
    "targets": {
      "gpu": ["rtx 4090", "rtx 4070", "rtx 3080", "rtx 3070", "rx 7900", "rx 6800"],
      "cpu": ["ryzen 7", "ryzen 9", "core i7", "core i9"],
      "ram": ["ddr5 32gb", "ddr4 32gb"]
    }
  },

  "valuation": {
    "minSamples": 8,
    "minDiscount": 0.3,
    "minProfit": 50,
    "minRoi": 0.3,
    "resalePercentile": 45,
    "feePercent": 13.25,
    "shippingCostByType": { "cpu": 6, "gpu": 18, "ram": 6 }
  },

  "risk": {
    "minFeedbackScore": 20,
    "minFeedbackPercentage": 95,
    "maxDiscount": 0.8,
    "skipRisky": true
  },

  "notifications": {
    "console": true,
    "webhookUrl": null,
    "ntfyTopic": null,
    "maxPerScan": 25
  },

  "watch": { "intervalMinutes": 30 }
}
